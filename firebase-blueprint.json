      "description": "Head-to-head match requests between verified League members"
    },
    "/leagueMatches/{matchId}": {
      "schema": "LeagueMatch",
      "description": "Official League head-to-head match fixtures and dual confirmation"
    },
    "/leagueDisputes/{disputeId}": {
      "schema": "LeagueDispute",
      "description": "League match disputes submitted for admin resolution"
    },
    "/socialActivity/{activityId}": {
      "schema": "SocialActivity",
      "description": "System-generated competitive activity events"
    },
    "/communityPosts/{postId}": {
      "schema": "CommunityPost",
      "description": "Verified member community posts and opponent search"
    },
    "/communityReports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Reports against community posts for moderator review"
    },
    "/userBlocks/{blockId}": {
      "schema": "UserBlock",
      "description": "Player-level user blocking records"
    },
    "/notifications/{notificationId}": {
      "schema": "InAppNotification",
