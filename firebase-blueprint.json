    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global tournament settings"
    },
    "/admins/{adminUid}": {
      "schema": "User",
      "description": "Admin identity records"
    },
    "/leagues/{leagueId}": {
      "schema": "LeagueSeason",
      "description": "Official League season configuration"
    },
    "/leagueMembers/{memberDocId}": {
      "schema": "LeagueMember",
      "description": "League membership cards and standings stats"
    },
    "/leaguePayments/{paymentId}": {
      "schema": "LeaguePayment",
      "description": "KSh50 League Card M-Pesa manual verification records"
    },
    "/leagueChallenges/{challengeId}": {
